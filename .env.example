# ---- InferEdge configuration ------------------------------------------
# Copy to .env and adjust. Everything works out of the box in mock mode.

# mock  — simulated inference, no GPU or API key needed (default)
# nim   — NVIDIA NIM / build.nvidia.com hosted endpoint (needs API key)
# local — placeholder for self-hosted vLLM / TensorRT-LLM / Triton
INFERENCE_MODE=mock

# Get a free key at https://build.nvidia.com (required for INFERENCE_MODE=nim)
NVIDIA_API_KEY=

# Model served for "large"-tier traffic in nim mode
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Model the semantic router sends "small"-tier traffic to in nim mode
NVIDIA_NIM_SMALL_MODEL=nvidia/mistral-nemo-minitron-8b-8k-instruct

# Optional overrides
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MAX_CONCURRENCY=4   # in-flight request cap (free tier is rate limited)
# NIM_MAX_RETRIES=5       # retries on 429 / 5xx with exponential backoff
# METRICS_WINDOW=200
# PROMPT_CACHE_MAX_ENTRIES=512
